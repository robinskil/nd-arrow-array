from typing import Any, Mapping, Optional, Sequence, Tuple, Union

import numpy as np

Dims = Union[Mapping[str, int], Sequence[Tuple[str, int]]]
Attrs = Optional[Mapping[str, Any]]

class NdFormatError(ValueError): ...

class NdArray:
    @staticmethod
    def from_numpy(arr: np.ndarray, dims: Sequence[str], attrs: Attrs = None) -> NdArray: ...
    @property
    def dims(self) -> Tuple[str, ...]: ...
    @property
    def shape(self) -> Tuple[int, ...]: ...
    @property
    def sizes(self) -> dict[str, int]: ...
    @property
    def ndim(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    @property
    def attrs(self) -> dict[str, Any]: ...
    @attrs.setter
    def attrs(self, value: Attrs) -> None: ...
    def set_attr(self, name: str, value: Any) -> None: ...
    def del_attr(self, name: str) -> None: ...
    def with_attrs(self, attrs: Attrs) -> NdArray: ...
    def reshape(self, dims: Dims) -> NdArray: ...
    def to_numpy(self) -> np.ndarray: ...
