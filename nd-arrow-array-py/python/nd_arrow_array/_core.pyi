from typing import Any, Iterator, Mapping, Optional, Sequence, Tuple, Union

import numpy as np

Dims = Union[Mapping[str, int], Sequence[Tuple[str, int]]]
Attrs = Optional[Mapping[str, Any]]

class NdFormatError(ValueError): ...

class NdArray:
    def __init__(self, values: Any, dims: Dims, attrs: Attrs = None) -> None: ...
    @property
    def values(self) -> Any: ...
    def __arrow_c_array__(self, requested_schema: Any = None) -> tuple[Any, Any]: ...
    @staticmethod
    def from_numpy(arr: np.ndarray, dims: Sequence[str], attrs: Attrs = None) -> NdArray: ...
    @property
    def dims(self) -> Tuple[str, ...]: ...
    @property
    def shape(self) -> Tuple[int, ...]: ...
    @property
    def sizes(self) -> dict[str, int]: ...
    @property
    def ndim(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    @property
    def attrs(self) -> dict[str, Any]: ...
    @attrs.setter
    def attrs(self, value: Attrs) -> None: ...
    def set_attr(self, name: str, value: Any) -> None: ...
    def del_attr(self, name: str) -> None: ...
    def with_attrs(self, attrs: Attrs) -> NdArray: ...
    def reshape(self, dims: Dims) -> NdArray: ...
    def to_numpy(self) -> np.ndarray: ...

class NdColumn:
    @staticmethod
    def from_arrow(obj: Any) -> NdColumn: ...
    def to_arrow(self) -> Any: ...
    def __arrow_c_array__(self, requested_schema: Any = None) -> tuple[Any, Any]: ...
    def __arrow_c_schema__(self) -> Any: ...
    @staticmethod
    def from_arrays(items: Sequence[Optional[NdArray]]) -> NdColumn: ...
    @property
    def null_count(self) -> int: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Optional[NdArray]: ...
    def __iter__(self) -> Iterator[Optional[NdArray]]: ...

class NdRecordBatch:
    def __init__(
        self,
        columns: Mapping[str, NdArray],
        attrs: Attrs = None,
        target: Optional[Dims] = None,
    ) -> None: ...
    @staticmethod
    def from_arrow(obj: Any) -> list[NdRecordBatch]: ...
    @property
    def target(self) -> dict[str, int]: ...
    @property
    def attrs(self) -> dict[str, Any]: ...
    @attrs.setter
    def attrs(self, value: Attrs) -> None: ...
    def keys(self) -> list[str]: ...
    def __getitem__(self, name: str) -> NdArray: ...
    def __len__(self) -> int: ...
    def to_arrow(self) -> Any: ...
    def __arrow_c_stream__(self, requested_schema: Any = None) -> Any: ...
    def __arrow_c_schema__(self) -> Any: ...

def encode_batches(batches: Sequence[NdRecordBatch]) -> Any: ...
